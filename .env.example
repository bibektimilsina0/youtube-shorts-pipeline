# ──────────────────────────────────────────────────────────────
# Verticals — environment configuration
#
# Copy this file to .env and fill in your keys:
#     cp .env.example .env
#
# NOTE: the pipeline does NOT read .env by itself. Load it first:
#     set -a && source .env && set +a
#     python -m verticals run --topic "..." --niche comedy
#
# Resolution order for every key below: environment variable,
# then ~/.verticals/config.json. Env always wins.
# ──────────────────────────────────────────────────────────────


# ══ REQUIRED ══════════════════════════════════════════════════
# Gemini — writes the script AND generates the b-roll imagery.
# Must be an AI Studio key: https://aistudio.google.com/apikey
# A Vertex AI key or service-account credential fails with
# "403: Method doesn't allow unregistered callers".
#
# Without this key the pipeline still runs, but b-roll silently
# degrades to solid-colour frames (see verticals/broll.py).
GEMINI_API_KEY=

# Pair it with:  --provider gemini


# ══ YOUTUBE UPLOAD ════════════════════════════════════════════
# Not set here. Upload uses an OAuth token file, not an API key:
#     python scripts/setup_youtube_oauth.py
# which signs you in via Google in the browser and writes
#     ~/.verticals/youtube_token.json
#
# Upload visibility: public | unlisted | private
# Requires the privacy patch in verticals/upload.py; unpatched,
# every upload is private regardless of what you set here.
# Left blank = private, so a missing value can never publish.
YT_PRIVACY=


# ══ OPTIONAL — alternative LLM providers ══════════════════════
# Only needed if you switch --provider away from gemini.

# --provider claude
# A console API key, NOT a Claude Code OAuth token.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --provider claude, headless/CI alternative to the key above.
# From `claude setup-token`; consumed by the claude CLI.
CLAUDE_CODE_OAUTH_TOKEN=

# --provider openai
OPENAI_API_KEY=

# --provider minimax  (also usable for voice)
MINIMAX_API_KEY=

# --provider ollama needs no key (local model).


# ══ OPTIONAL — voice ══════════════════════════════════════════
# Default --voice edge (edge-tts) is free and needs no key.

# --voice elevenlabs
ELEVENLABS_API_KEY=

# --voice 60db
SIXTYDB_API_KEY=

# ElevenLabs voice IDs (defaults to "George" for both)
VOICE_ID_EN=
VOICE_ID_HI=


# ══ OPTIONAL — topic discovery ════════════════════════════════
# --discover works without any key: Reddit, RSS, Google Trends,
# YouTube trending and Hacker News all need no auth.
# This only adds NewsAPI as an extra source.
NEWSAPI_KEY=

# Gemini model overrides. The repo's original defaults (gemini-2.0-flash and
# gemini-2.0-flash-exp-image-generation) were retired by Google and 404.
# Blank = the patched defaults below. List your key's models with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_TEXT_MODEL=gemini-3.6-flash
# NOTE: image generation is NOT available on the Gemini free tier (429).
# Without it, b-roll falls back to solid-colour frames.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Image provider: cloudflare | pollinations | gemini
#   pollinations  free, no API key, no quota (Flux). Returns 576x1024 and the
#                 pipeline rescales, so frames are softer than native 1080x1920.
#   cloudflare    FLUX.1-schnell. Best free quality; needs a free Cloudflare
#                 account (see below). Square output, cropped to 9:16.
#   gemini        better quality, but image generation is NOT on the free tier
#                 (429 on every image model until billing is enabled).
IMAGE_PROVIDER=pollinations
# Optional Pollinations model override (blank = their default)
POLLINATIONS_MODEL=

# ── Cloudflare Workers AI (best free image quality) ───────────────
# Free account, no credit card. 10,000 neurons/day = ~100 images at 8 steps;
# this pipeline uses 4 per video, so ~26 videos/day fit in the free tier.
#   1. dash.cloudflare.com -> sign up (free)
#   2. Account ID: Workers & Pages -> Overview, right sidebar
#   3. Token: My Profile -> API Tokens -> Create Token
#            -> Custom token -> Permissions: Account | Workers AI | Read
# Then set IMAGE_PROVIDER=cloudflare above.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Denoising steps, 1-8 (API max is 8). Higher = better detail, more neurons.
CLOUDFLARE_STEPS=8
# Model override; blank = @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_MODEL=

# Seconds to wait for a Gemini text response. The 3.x thinking models
# occasionally take just over a minute, which the repo's original 60s timeout
# turned into a hard failure. Blank = 180.
GEMINI_TIMEOUT=

# Number of b-roll stills per video, 1-30 (blank = 3).
# Frames stretch to fill the voiceover, so scale this with the niche's
# word_count: ~4-6s per frame reads well. A 100-200 word script is 40-80s,
# which wants about 10 frames.
BROLL_FRAMES=10

# ── Editing (verticals/assemble.py, verticals/broll.py) ───────────
# These are module constants, not env vars — edit the files to change them:
#   XFADE_SECONDS      0.45  crossfade length between shots
#   FIRST_SHOT_WEIGHT  1.35  the opening shot is held longer
#   LAST_SHOT_WEIGHT   1.25  so is the closing shot
#   KB_ZOOM            1.22  Ken Burns travel (was 1.12 upstream)
#   KEN_BURNS_MOVES          9 moves: zooms, 4 pans, 3 diagonals
# Shot boundaries snap to caption ends when one falls within 1.5s.
